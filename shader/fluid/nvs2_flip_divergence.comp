#version 430 core
#extension GL_GOOGLE_include_directive : require

#include "nvs2_flip.glsl"
layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

float div_v(ivec2 p)
{
	float div = 0;

	ivec2 size = imageSize(f_out);

	int offset = 0;
	for (int i = 0; i < DIMS; ++i) {
		uint row_size = size[i] + 1;
		uint idx = row_size * p[(i + 1) % DIMS] + p[i];
		uint offset = s_offsets[i];

		div += s_vel[offset + idx + 1] - s_vel[offset + idx];  
	}

	return div/(2*DELTA_X); 
}

void main()
{
    ivec2 idx = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(f_out);

	if (idx.x >= size.x || idx.y >= size.y)
		return;

	float f = RHO*div_v(idx)/TIMESTEP;

	imageStore(f_out, idx, vec4(f, 0, 0, 0));
}
