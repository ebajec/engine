float residual(ivec2 idx, float rhs, float h)
{
	vec2 bd = get_bd(idx);
	float wt_c = bd.r;
	float phi_c = bd.g;

	float u = wt_c * block[idx.x][idx.y];

	if (wt_c < OOB_CELL_THRES || phi_c > 0) {
		return 0.f;
	}

	ivec2 stencil[4] = {
		ivec2(-1,0),
		ivec2(1,0), 
		ivec2(0,1), 
		ivec2(0,-1)
	};

	float lap = 0.f;

	for (int i = 0; i < 4; ++i) {
		ivec2 p = clamp(idx + stencil[i], ivec2(0), ivec2(GROUPS -1));

		vec2 bd = get_bd(p);
		const bool is_air = bd.g > 0;

		float val = is_air ? 0.f : block[p.x][p.y];
		float wt = is_air ? face_frac(phi_c, bd.g) : bd.r;

		lap += mix(u, val, wt);
	}

	lap -= 4.f * u;
	lap /= h*h;

	//ivec2 l_idx = clamp(idx + ivec2(-1,0), ivec2(0), ivec2(GROUPS -1));
	//ivec2 r_idx = clamp(idx + ivec2(1,0), ivec2(0), ivec2(GROUPS - 1));
	//ivec2 t_idx = clamp(idx + ivec2(0,1), ivec2(0), ivec2(GROUPS - 1));
	//ivec2 b_idx = clamp(idx + ivec2(0,-1), ivec2(0), ivec2(GROUPS - 1));

	//float fill_l;
	//float fill_r;
	//float fill_t;
	//float fill_b;

	//vec2 bd_l = get_bd(l_idx, fill_l);
	//vec2 bd_r = get_bd(r_idx, fill_r);
	//vec2 bd_t = get_bd(t_idx, fill_t);
	//vec2 bd_b = get_bd(b_idx, fill_b);

	//float l = bd_l.g > 0 ? 0.f : block[l_idx.x][l_idx.y];
	//float r = bd_l.g > 0 ? 0.f : block[r_idx.x][r_idx.y];
	//float t = bd_l.g > 0 ? 0.f : block[t_idx.x][t_idx.y];
	//float b = bd_l.g > 0 ? 0.f : block[b_idx.x][b_idx.y];

	//float lap = (
	//	mix(u, l, bd_l.r) + mix(u, r, bd_r.r) + 
	//	mix(u, t, bd_t.r) + mix(u, b, bd_b.r) 
	//	- 4.f*u
	//)/(h*h);

	return lap - rhs;
}

