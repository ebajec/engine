float fetch_rhs(ivec2 idx)
{
	// u_level == 0 is the original rhs; > 0
	// we downsample the residuals from the previous level
	if (u_level > 0) {
		ivec2 stencil[9] = {
			2*idx,

			2*idx + ivec2(-1,0),
			2*idx + ivec2(1,0),
			2*idx + ivec2(0,-1),
			2*idx + ivec2(0,1),

			2*idx + ivec2(-1,-1),
			2*idx + ivec2(-1,1),
			2*idx + ivec2(1,-1),
			2*idx + ivec2(1,1),
		};

		uint L = u_level - 1;

		float wt[9] = {1, 2,2,2,2, 1,1,1,1};

		float phi_c;
		float wt_c;
		float center = RHS(2*idx, L, wt_c, phi_c);

		center *= float(phi_c <= 0);

		float num = 0;
		float den = 0;
		for (int i = 0; i < 9; ++i) {
			float phi_i;
			float wt_i;
			float value = RHS(stencil[i], L, wt_i, phi_i);

			const bool is_air = phi_i > 0;

			num += is_air ? 0 : wt_i * wt[i] * mix(center,value,wt_i);
			den += wt_i * wt[i];
		}
		return den > 0 ? num/den : 0;
	}

	return imageLoad(in_rhs, idx).x;
}

void main()
{
	// index in local block
	ivec2 idx = ivec2(gl_LocalInvocationID.xy);

	// index in grid coordinates 
	// I.e., for groups = 8, j = 2
	// i i i i i i i i            
	// i i i i i i i i                             
	// i i o o o o i i                             
	// i i o o o o i i                             
	// i i o o o o i i                             
	// i i o o o o i i                             
	// i i i i i i i i                             
	// i i i i i i i i                             
	ivec2 out_idx = idx - ivec2(u_iterations); 

	int out_width = GROUPS - 2*int(u_iterations);

	ivec2 grid_idx = 
		ivec2(gl_WorkGroupID.xy) * out_width + out_idx;

	const float h = DELTA_X;

	float rhs = fetch_rhs(grid_idx);
	float lhs = fetch_lhs(grid_idx, rhs, h);
	vec2 bd = get_bd_mask(grid_idx, u_level);

	if (bd.r < OOB_CELL_THRES) {
		rhs = 0;
		lhs = 0;
	}

	set_bd(idx, bd);
	block[idx.x][idx.y] = lhs;  

	float u_prev = lhs;

	for (int i = 0; i < u_iterations - 1; ++i) {
		barrier();

		float old = lhs;
		lhs = jacobi_it(false, idx, rhs, u_prev, h);
		u_prev = old;

		barrier();

		block[idx.x][idx.y] = lhs;
	}
	barrier();

	bool outside = 
		out_idx.x < 0 || out_idx.y < 0 || 
		out_idx.x >= out_width || out_idx.y >= out_width; 

	if (outside)
		return;

	if (bd.r < OOB_CELL_THRES) { 
		lhs = 0;
		rhs = 0;
	}

	if (u_level < N) {
		float res = residual(idx, rhs, h);
		imageStore(R1[u_level], grid_idx, vec4(res,0,0,0));
	}

	if (u_level > 0) {
		imageStore(R2[u_level - 1], grid_idx, vec4(lhs,0,0,0));
	} else { 
		imageStore(tmp_lhs, grid_idx, vec4(lhs,0,0,0));
	}
}
